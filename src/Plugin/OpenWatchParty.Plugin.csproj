<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- RootNamespace + AssemblyName MUST stay OpenWatchParty.Plugin: the controller resolves the
         client bundle as the embedded resource "OpenWatchParty.Plugin.Web.plugin.js" and the config
         page as "OpenWatchParty.Plugin.Web.configPage.html". Renaming either breaks resource lookup. -->
    <RootNamespace>OpenWatchParty.Plugin</RootNamespace>
    <AssemblyName>OpenWatchParty.Plugin</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CS1591</NoWarn>
    <!-- Plugins load into their own AssemblyLoadContext: third-party package DLLs the host does not
         provide (the Microsoft.IdentityModel.* / System.IdentityModel.Tokens.Jwt stack that mints the
         session-server JWT) must be physically copied next to the plugin. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Controller endpoints (/OpenWatchParty/*) are hosted by Jellyfin's ASP.NET pipeline; the
    FrameworkReference gives us ControllerBase/MVC. The IdentityModel stack (8.3.0, the versions
    proven in jellyops-plugin-oauth2) mints the HMAC-SHA256 JWT the Rust session server validates.
    Newtonsoft is ExcludeAssets=runtime on purpose — see the ItemGroup note below.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.3.0" />
    <!-- Bind to the HOST's Newtonsoft.Json (server ships /jellyfin/Newtonsoft.Json.dll via
         MediaBrowser.Providers) rather than shipping our own. LOAD-BEARING for FT interop:
         FileTransformationIntegration reflection-invokes Jellyfin.Plugin.FileTransformation
         .PluginInterface.RegisterTransformation(JObject). If OWP and FT each shipped Newtonsoft into
         separate plugin ALCs, the two JObject types would differ by assembly identity and the Invoke
         would throw. Both plugins ExcludeAssets=runtime so both resolve the host Default-ALC copy —
         matching JObject identity. (FT's csproj carries the mirror of this note.) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    Compile against the EXACT Jellyfin v12 rc3 assemblies the running server loads
    (v12.0.0-rc3-jc-0.2.1), but do NOT ship copies (Private=false + ExcludeAssets=runtime).
    Shipping duplicate MediaBrowser.* DLLs causes type-identity conflicts in the plugin ALC.
  -->
  <ItemGroup>
    <ProjectReference Include="../../../jellyfin-src/MediaBrowser.Controller/MediaBrowser.Controller.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="../../../jellyfin-src/MediaBrowser.Common/MediaBrowser.Common.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="../../../jellyfin-src/MediaBrowser.Model/MediaBrowser.Model.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="meta.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Embedded resources served by the plugin:
    - Web/plugin.js     the concatenated client bundle (generated by scripts/bundle-client.sh from
                        the raw modules under Web/client/), served by /OpenWatchParty/ClientScript.
    - Web/configPage.html  the dashboard settings page (IHasWebPages).
    The raw Web/client/**/*.js modules are build-time SOURCE ONLY (input to the bundler); they are
    neither compiled nor embedded.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Web/plugin.js" />
    <EmbeddedResource Include="Web/configPage.html" />
    <None Include="Web/client/**/*" />
  </ItemGroup>

  <!-- Strip host assemblies from BOTH build and publish output (publish emits the full closure,
       dragging in transitive Jellyfin.*/Emby.*/MediaBrowser.* even though direct refs are
       Private=false). Keep only our own assembly + the third-party JWT deps the host lacks. -->
  <Target Name="StripHostAssemblies" AfterTargets="Build">
    <ItemGroup>
      <_HostAssemblies Include="$(OutDir)Emby.*;$(OutDir)Jellyfin.*;$(OutDir)MediaBrowser.*"
                       Exclude="$(OutDir)OpenWatchParty.Plugin*" />
    </ItemGroup>
    <Delete Files="@(_HostAssemblies)" />
  </Target>
  <Target Name="StripHostAssembliesFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PubHostAssemblies Include="$(PublishDir)Emby.*;$(PublishDir)Jellyfin.*;$(PublishDir)MediaBrowser.*"
                          Exclude="$(PublishDir)OpenWatchParty.Plugin*" />
    </ItemGroup>
    <Delete Files="@(_PubHostAssemblies)" />
  </Target>

</Project>
